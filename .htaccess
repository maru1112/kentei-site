# URL正規化:http→https、www有り→無し を https://kentei-center.or.jp/ に統一(301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.kentei-center\.or\.jp [NC]
  RewriteRule ^(.*)$ https://kentei-center.or.jp/$1 [R=301,L]
</IfModule>

# データベースファイルは絶対に公開しない（誤配置時の保険）
<FilesMatch "\.(db|sqlite|sqlite3)$">
  Require all denied
</FilesMatch>

# 作業メモ（CLAUDE.md・README.md など）は公開しない
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>

# 安全用の応答ヘッダー（セキュリティ点検 2026-11-02）
#  HSTS=常にhttpsで開かせる／nosniff=ファイルの種類の取り違えを防ぐ／SAMEORIGIN=他サイトへの埋め込み（なりすまし画面）を防ぐ
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
