# URL正規化:http→https、www有り→無し を https://kentei-center.or.jp/ に統一(301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.kentei-center\.or\.jp [NC]
  RewriteRule ^(.*)$ https://kentei-center.or.jp/$1 [R=301,L]
</IfModule>

# データベースファイルは絶対に公開しない（誤配置時の保険）
<FilesMatch "\.(db|sqlite|sqlite3)$">
  Require all denied
</FilesMatch>

# 作業メモ（CLAUDE.md・README.md など）は公開しない
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
